<mxfile host="app.diagrams.net" modified="2026-09-22T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="fantasy-architecture" name="System Architecture"><mxGraphModel dx="1900" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1480" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="bg" value="" style="fillColor=#f5f8fc;strokeColor=none;locked=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="2000" height="1480" as="geometry" /></mxCell><mxCell id="title" value="Fantasy Football Recommender" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=36;fontStyle=1;fontColor=#14273e;" vertex="1" parent="1"><mxGeometry x="65" y="40" width="1400" height="52" as="geometry" /></mxCell><mxCell id="subtitle" value="V1 architecture | modular backend | scheduled refresh | beginner-friendly explanations" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=19;fontColor=#566980;" vertex="1" parent="1"><mxGeometry x="65" y="93" width="1750" height="32" as="geometry" /></mxCell><mxCell id="request_bg" value="" style="rounded=1;arcSize=4;fillColor=#eaf1fb;strokeColor=#d4e2f4;strokeWidth=1;locked=1;" vertex="1" parent="1"><mxGeometry x="45" y="145" width="1910" height="565" as="geometry" /></mxCell><mxCell id="request_label" value="01  INTERACTIVE REQUEST  |  HTTPS / JSON" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontColor=#345a91;" vertex="1" parent="1"><mxGeometry x="68" y="165" width="1200" height="38" as="geometry" /></mxCell><mxCell id="request_note" value="Requests read the last published snapshot. External provider fetches run separately." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#526783;" vertex="1" parent="1"><mxGeometry x="68" y="202" width="1540" height="28" as="geometry" /></mxCell><mxCell id="refresh_bg" value="" style="rounded=1;arcSize=4;fillColor=#ecf8f5;strokeColor=#d3eae4;strokeWidth=1;locked=1;" vertex="1" parent="1"><mxGeometry x="45" y="750" width="1910" height="520" as="geometry" /></mxCell><mxCell id="refresh_label" value="02  SCHEDULED REFRESH  |  INDEPENDENT OF USER REQUESTS" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontStyle=1;fontColor=#167664;" vertex="1" parent="1"><mxGeometry x="68" y="768" width="1650" height="38" as="geometry" /></mxCell><mxCell id="refresh_note" value="External sources are candidates. Confirm terms, commercial rights, field coverage, and freshness." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#4a6d66;" vertex="1" parent="1"><mxGeometry x="68" y="807" width="1710" height="28" as="geometry" /></mxCell><mxCell id="web" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;WEB  |  React + TypeScript&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Manual roster and league settings&lt;br/&gt;Start/sit and full lineup&lt;br/&gt;Status, reasons, glossary&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#ffffff;strokeColor=#4969a2;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="330" height="190" as="geometry" /></mxCell><mxCell id="api" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;API  |  FastAPI + Python&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Session and ownership checks&lt;br/&gt;Input validation; rate limiting&lt;br/&gt;Roster edits; optional import&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#ffffff;strokeColor=#4969a2;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="465" y="260" width="355" height="190" as="geometry" /></mxCell><mxCell id="engine" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;RECOMMENDATION ENGINE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Canonical IDs and scoring rules&lt;br/&gt;Projection and uncertainty&lt;br/&gt;Slot eligibility and lineup solver&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#ffffff;strokeColor=#4969a2;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="885" y="260" width="465" height="190" as="geometry" /></mxCell><mxCell id="db" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;MANAGED POSTGRESQL&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Users, leagues, roster versions&lt;br/&gt;Player, scoring and week history&lt;br/&gt;Active validated snapshot ID&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#f8fdfb;strokeColor=#17836e;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1415" y="260" width="475" height="190" as="geometry" /></mxCell><mxCell id="explain" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;EXPLANATION + GLOSSARY&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Reasons use the decision facts&lt;br/&gt;1–2 sentences; define each term&lt;br/&gt;Show source age and uncertainty&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#ffffff;strokeColor=#4969a2;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="885" y="525" width="465" height="145" as="geometry" /></mxCell><mxCell id="result" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;RECOMMENDATION RESPONSE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Valid lineup or close call&lt;br/&gt;Plain-English reasons and warnings&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#ffffff;strokeColor=#4969a2;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="465" y="525" width="355" height="145" as="geometry" /></mxCell><mxCell id="freshness" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;FRESHNESS GUARD&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Show age of last valid snapshot&lt;br/&gt;Pause unsafe injury-dependent picks&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#fffbf3;strokeColor=#bd7523;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1415" y="525" width="475" height="145" as="geometry" /></mxCell><mxCell id="source" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;PERMITTED NFL DATA FEED&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;nflverse: candidate stats/history&lt;br/&gt;Status source and cadence: TBD&lt;br/&gt;No live in-game updates&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#fcfaff;strokeColor=#6f5caa;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="860" width="330" height="175" as="geometry" /></mxCell><mxCell id="adapter" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;PROVIDER ADAPTERS&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Fetch; isolate upstream changes&lt;br/&gt;Normalize IDs and timestamps&lt;br/&gt;Retries and failure reports&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#fcfaff;strokeColor=#6f5caa;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="465" y="860" width="355" height="175" as="geometry" /></mxCell><mxCell id="worker" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;SCHEDULER + WORKER&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Weekly batch and status refresh&lt;br/&gt;Transform stats; build projections&lt;br/&gt;Persist job success or failure&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#f8fdfb;strokeColor=#17836e;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="885" y="860" width="465" height="175" as="geometry" /></mxCell><mxCell id="stage" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;STAGE + VALIDATE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Schema, mapping, record counts&lt;br/&gt;Check season/week and prior version&lt;br/&gt;Atomically publish snapshot ID&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#f8fdfb;strokeColor=#17836e;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1415" y="860" width="475" height="175" as="geometry" /></mxCell><mxCell id="sleeper" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;SLEEPER API CANDIDATE&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Read-only league and roster import&lt;br/&gt;Commercial rights approval needed&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#fcfaff;strokeColor=#6f5caa;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="1100" width="330" height="125" as="geometry" /></mxCell><mxCell id="manual" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;MANUAL ROSTER FALLBACK&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Browser → API → saved roster&lt;br/&gt;Review any unknown player IDs&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#fffbf3;strokeColor=#bd7523;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="465" y="1100" width="355" height="125" as="geometry" /></mxCell><mxCell id="evaluation" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;EVALUATION JOBS&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Leakage-safe historical backtests&lt;br/&gt;Compare with documented baseline&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#f8fdfb;strokeColor=#17836e;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="885" y="1100" width="465" height="125" as="geometry" /></mxCell><mxCell id="operations" value="&lt;div style=&quot;font-family:Arial;text-align:left;padding:4px&quot;&gt;&lt;b style=&quot;font-size:17px&quot;&gt;HEALTH + RECOVERY&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:13px;line-height:1.5&quot;&gt;Refresh age; failed jobs; p95 latency&lt;br/&gt;Backups, restore drill, rollback&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#fffbf3;strokeColor=#bd7523;strokeWidth=2;fontColor=#15263d;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1415" y="1100" width="475" height="125" as="geometry" /></mxCell><mxCell id="e_web_api" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4969a2;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="web" target="api"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_api_engine" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4969a2;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="api" target="engine"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_engine_db" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#17a18a;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="engine" target="db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_engine_explain" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4969a2;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="engine" target="explain"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_explain_result" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4969a2;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="explain" target="result"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_result_web" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4969a2;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="result" target="web"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_db_guard" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#17a18a;strokeWidth=3;endArrow=block;endFill=1;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="db" target="freshness"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_source_adapter" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#17a18a;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="source" target="adapter"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_adapter_worker" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#17a18a;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="adapter" target="worker"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_worker_stage" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#17a18a;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="worker" target="stage"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_stage_db" value="publish only after validation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#17a18a;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="stage" target="db"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_sleeper_adapter" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#17a18a;strokeWidth=3;endArrow=block;endFill=1;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="sleeper" target="adapter"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="guardrails" value="DESIGN GUARDRAILS&lt;br/&gt;Import needs provider permission. Requests never wait for external feeds. Partial snapshots are never served.&lt;br/&gt;Waivers/trades are later modules. Redis, queues, and multiple API instances follow measured need." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#ffffff;strokeColor=#d6e0ea;strokeWidth=1;fontColor=#33465e;fontFamily=Arial;fontSize=18;" vertex="1" parent="1"><mxGeometry x="45" y="1305" width="1910" height="118" as="geometry" /></mxCell><mxCell id="legend" value="Blue: interactive request     Green: refresh and storage     Dashed: optional or conditional path" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=16;fontColor=#61758c;" vertex="1" parent="1"><mxGeometry x="68" y="1440" width="1750" height="25" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>